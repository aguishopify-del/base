{{ 'skr-styles.css' | asset_url | stylesheet_tag }}
{{ 'skr-scripts.js' | asset_url | script_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
  }
{% endstyle %}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="skr-producto skr-section">
  <div class="skr-container skr-producto-inner">

    {%- comment -%} Galería {%- endcomment -%}
    <div class="skr-galeria" data-skr-galeria>
      <div class="skr-galeria-principal">
        {%- if product.featured_media != blank -%}
          <img src="{{ product.featured_media | image_url: width: 1200 }}" alt="{{ product.featured_media.alt | default: product.title | escape }}" loading="eager" fetchpriority="high" class="skr-img-cover" data-skr-imagen-principal>
        {%- else -%}
          <div class="skr-galeria-vacia"></div>
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="skr-galeria-thumbs">
          {%- for media in product.media limit: 8 -%}
            <button type="button" class="skr-thumb {% if forloop.first %}skr-thumb-activo{% endif %}" data-skr-thumb data-full="{{ media | image_url: width: 1200 }}" data-alt="{{ media.alt | escape }}">
              <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" loading="lazy" class="skr-img-cover">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Columna de compra {%- endcomment -%}
    <div class="skr-compra">
      {%- if section.settings.eyebrow != blank -%}<p class="skr-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="skr-h1 skr-producto-titulo">{{ product.title }}</h1>

      <div class="skr-producto-precio">
        <span data-skr-precio>{{ current_variant.price | money }}</span>
        <s data-skr-precio-compare style="{% if current_variant.compare_at_price <= current_variant.price %}display:none;{% endif %}">{{ current_variant.compare_at_price | money }}</s>
      </div>

      <div class="skr-producto-intro">{{ section.settings.intro | default: product.description | strip_html | truncatewords: 60 }}</div>

      {% form 'product', product, data-skr-form-producto: '' %}
        <script type="application/json" data-skr-variantes-json>
          [
            {%- for variant in product.variants -%}
              {
                "id": {{ variant.id | json }},
                "options": {{ variant.options | json }},
                "price": {{ variant.price | json }},
                "compare_at_price": {{ variant.compare_at_price | json }},
                "available": {{ variant.available | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        </script>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="skr-opcion">
              <label class="skr-opcion-label">{{ option.name }}</label>
              <select class="skr-opcion-select" data-skr-opcion>
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}" {% if value == option.selected_value %}selected{% endif %}>{{ value }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <input type="hidden" name="id" value="{{ current_variant.id }}">

        <div class="skr-cantidad-compra">
          <div class="skr-cantidad">
            <button type="button" class="skr-cantidad-btn" data-skr-menos aria-label="Menos">−</button>
            <input type="number" name="quantity" value="1" min="1" class="skr-cantidad-input">
            <button type="button" class="skr-cantidad-btn" data-skr-mas aria-label="Más">+</button>
          </div>
          <button type="submit" name="add" class="skr-btn skr-btn-primario skr-btn-comprar" data-skr-boton-comprar data-texto-normal="{{ section.settings.boton_texto | escape }}" data-texto-agotado="{{ section.settings.boton_agotado | escape }}" {% if current_variant.available == false %}disabled{% endif %}>
            {%- if current_variant.available == false -%}{{ section.settings.boton_agotado }}{%- else -%}{{ section.settings.boton_texto }}{%- endif -%}
          </button>
        </div>
      {% endform %}

      <div class="skr-confianza-fila">
        <span>✓ {{ section.settings.confianza_1 }}</span>
        <span>✓ {{ section.settings.confianza_2 }}</span>
        <span>✓ {{ section.settings.confianza_3 }}</span>
      </div>
    </div>
  </div>

  {%- comment -%} Características {%- endcomment -%}
  {%- assign hay_caracteristicas = false -%}
  {%- for i in (1..4) -%}
    {%- assign k = 'caract_' | append: i | append: '_titulo' -%}
    {%- if section.settings[k] != blank -%}{%- assign hay_caracteristicas = true -%}{%- endif -%}
  {%- endfor -%}
  {%- if hay_caracteristicas -%}
    <div class="skr-container skr-caracteristicas skr-reveal-stagger skr-reveal">
      {%- for i in (1..4) -%}
        {%- assign t_k = 'caract_' | append: i | append: '_titulo' -%}
        {%- assign x_k = 'caract_' | append: i | append: '_texto' -%}
        {%- assign t_v = section.settings[t_k] -%}
        {%- if t_v != blank -%}
          <div class="skr-caracteristica skr-reveal-child">
            <h3>{{ t_v }}</h3>
            <p>{{ section.settings[x_k] }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} Cómo se usa {%- endcomment -%}
  {%- if section.settings.uso_titulo != blank -%}
    <div class="skr-container skr-uso skr-reveal">
      <h2 class="skr-h2">{{ section.settings.uso_titulo }}</h2>
      <ol class="skr-uso-pasos">
        {%- assign pasos_lista = section.settings.uso_pasos | split: newline -%}
        {%- for paso in pasos_lista -%}
          {%- if paso != blank -%}<li>{{ paso }}</li>{%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
  {%- endif -%}

  {%- comment -%} Descripción completa del catálogo, como respaldo/ampliación {%- endcomment -%}
  {%- if product.description != blank -%}
    <div class="skr-container skr-descripcion-completa skr-reveal">
      <h2 class="skr-h2">{{ section.settings.descripcion_titulo }}</h2>
      <div class="skr-descripcion-rica">{{ product.description }}</div>
    </div>
  {%- endif -%}
</section>

<style>
  #shopify-section-{{ section.id }} .skr-producto-inner { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 60px; padding: 0 var(--skr-margen); max-width: 1240px; margin: 0 auto 80px; }
  #shopify-section-{{ section.id }} .skr-galeria-principal { aspect-ratio: 1/1; border-radius: var(--skr-radio); overflow: hidden; background: var(--skr-color-bg-alt); margin-bottom: 14px; }
  #shopify-section-{{ section.id }} .skr-galeria-vacia { width: 100%; height: 100%; background: linear-gradient(150deg, var(--skr-color-bg-alt), var(--skr-color-accent) 220%); }
  #shopify-section-{{ section.id }} .skr-galeria-thumbs { display: flex; gap: 10px; flex-wrap: wrap; }
  #shopify-section-{{ section.id }} .skr-thumb { width: 74px; height: 74px; border-radius: var(--skr-radio-sm); overflow: hidden; border: 2px solid transparent; padding: 0; cursor: pointer; background: var(--skr-color-bg-alt); }
  #shopify-section-{{ section.id }} .skr-thumb-activo { border-color: var(--skr-color-accent-dark); }
  #shopify-section-{{ section.id }} .skr-producto-titulo { font-size: 34px; margin-bottom: 14px; }
  #shopify-section-{{ section.id }} .skr-producto-precio { font-size: 26px; font-weight: 600; display: flex; gap: 12px; align-items: baseline; margin-bottom: 20px; }
  #shopify-section-{{ section.id }} .skr-producto-precio s { font-size: 17px; font-weight: 400; color: var(--skr-color-text-muted); }
  #shopify-section-{{ section.id }} .skr-producto-intro { font-size: 16px; line-height: 1.6; color: var(--skr-color-text-muted); margin-bottom: 24px; }
  #shopify-section-{{ section.id }} .skr-opcion { margin-bottom: 16px; }
  #shopify-section-{{ section.id }} .skr-opcion-label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
  #shopify-section-{{ section.id }} .skr-opcion-select { width: 100%; padding: 12px 14px; border-radius: var(--skr-radio-sm); border: 1px solid var(--skr-color-border); font-family: var(--skr-font-cuerpo); font-size: 15px; background: #fff; }
  #shopify-section-{{ section.id }} .skr-cantidad-compra { display: flex; gap: 14px; margin: 22px 0; }
  #shopify-section-{{ section.id }} .skr-cantidad { display: flex; align-items: center; border: 1px solid var(--skr-color-border); border-radius: 999px; overflow: hidden; }
  #shopify-section-{{ section.id }} .skr-cantidad-btn { width: 40px; height: 48px; border: none; background: transparent; font-size: 18px; cursor: pointer; }
  #shopify-section-{{ section.id }} .skr-cantidad-input { width: 40px; text-align: center; border: none; font-size: 15px; -moz-appearance: textfield; }
  #shopify-section-{{ section.id }} .skr-btn-comprar { flex: 1; justify-content: center; }
  #shopify-section-{{ section.id }} .skr-btn-comprar:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
  #shopify-section-{{ section.id }} .skr-confianza-fila { display: flex; flex-wrap: wrap; gap: 18px; font-size: 13px; color: var(--skr-color-text-muted); margin-top: 8px; }
  #shopify-section-{{ section.id }} .skr-caracteristicas { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 70px; }
  #shopify-section-{{ section.id }} .skr-caracteristica { background: var(--skr-color-card); border: 1px solid var(--skr-color-border); border-radius: var(--skr-radio-sm); padding: 22px; }
  #shopify-section-{{ section.id }} .skr-caracteristica h3 { font-family: var(--skr-font-titulo); font-size: 17px; font-weight: 500; margin: 0 0 8px; }
  #shopify-section-{{ section.id }} .skr-caracteristica p { font-size: 13.5px; color: var(--skr-color-text-muted); margin: 0; line-height: 1.5; }
  #shopify-section-{{ section.id }} .skr-uso { margin-bottom: 70px; }
  #shopify-section-{{ section.id }} .skr-uso-pasos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 0; margin: 24px 0 0; list-style: none; counter-reset: paso; }
  #shopify-section-{{ section.id }} .skr-uso-pasos li { counter-increment: paso; background: var(--skr-color-card); border: 1px solid var(--skr-color-border); border-radius: var(--skr-radio-sm); padding: 22px 22px 22px 54px; position: relative; font-size: 14.5px; }
  #shopify-section-{{ section.id }} .skr-uso-pasos li::before { content: counter(paso); position: absolute; left: 18px; top: 20px; width: 26px; height: 26px; border-radius: 50%; background: var(--skr-color-accent-dark); color: #fff; font-size: 13px; font-weight: 600; display: flex; align-items: center; justify-content: center; }
  #shopify-section-{{ section.id }} .skr-descripcion-completa { margin-bottom: 40px; }
  #shopify-section-{{ section.id }} .skr-descripcion-rica { font-size: 15.5px; line-height: 1.7; color: var(--skr-color-text-muted); }
  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} .skr-producto-inner { grid-template-columns: 1fr; gap: 28px; }
    #shopify-section-{{ section.id }} .skr-caracteristicas, #shopify-section-{{ section.id }} .skr-uso-pasos { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 540px) {
    #shopify-section-{{ section.id }} .skr-caracteristicas, #shopify-section-{{ section.id }} .skr-uso-pasos { grid-template-columns: 1fr; }
  }
</style>

<script>
  (function(){
    var wrap = document.currentScript.closest('.skr-producto') || document.querySelector('#shopify-section-{{ section.id }} .skr-producto');
    if (!wrap) return;
    var menos = wrap.querySelector('[data-skr-menos]');
    var mas = wrap.querySelector('[data-skr-mas]');
    var input = wrap.querySelector('.skr-cantidad-input');
    if (menos && mas && input) {
      menos.addEventListener('click', function(){ input.value = Math.max(1, (parseInt(input.value,10)||1) - 1); });
      mas.addEventListener('click', function(){ input.value = (parseInt(input.value,10)||1) + 1; });
    }
  })();
</script>

{% schema %}
{
  "name": "SKR – Página de producto",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Ritual Sielora Beauty" },
    { "type": "textarea", "id": "intro", "label": "Texto introductorio (vacío = usa la descripción)" },
    { "type": "text", "id": "boton_texto", "label": "Texto botón comprar", "default": "Añadir al carrito" },
    { "type": "text", "id": "boton_agotado", "label": "Texto botón agotado", "default": "Agotado" },
    { "type": "text", "id": "confianza_1", "label": "Confianza 1", "default": "Envío con seguimiento" },
    { "type": "text", "id": "confianza_2", "label": "Confianza 2", "default": "Devolución 30 días" },
    { "type": "text", "id": "confianza_3", "label": "Confianza 3", "default": "Pago seguro" },

    { "type": "header", "content": "Características (tarjetas)" },
    { "type": "text", "id": "caract_1_titulo", "label": "Título 1" },
    { "type": "textarea", "id": "caract_1_texto", "label": "Texto 1" },
    { "type": "text", "id": "caract_2_titulo", "label": "Título 2" },
    { "type": "textarea", "id": "caract_2_texto", "label": "Texto 2" },
    { "type": "text", "id": "caract_3_titulo", "label": "Título 3" },
    { "type": "textarea", "id": "caract_3_texto", "label": "Texto 3" },
    { "type": "text", "id": "caract_4_titulo", "label": "Título 4" },
    { "type": "textarea", "id": "caract_4_texto", "label": "Texto 4" },

    { "type": "header", "content": "Cómo se usa" },
    { "type": "text", "id": "uso_titulo", "label": "Título de la sección" },
    { "type": "textarea", "id": "uso_pasos", "label": "Pasos (uno por línea)" },

    { "type": "header", "content": "Descripción completa" },
    { "type": "text", "id": "descripcion_titulo", "label": "Título", "default": "Todos los detalles" },

    { "type": "color", "id": "color_fondo", "label": "Color de fondo", "default": "#FAF6F1" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 }
  ]
}
{% endschema %}
